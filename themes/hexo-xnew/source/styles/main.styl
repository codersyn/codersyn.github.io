main
  background $background-color
  flex 2
  hypens auto
  overflow-x hidden
  padding 20px
  text-align left
  word-break normal
  word-wrap break-word
  a.article
    color $body-color
    display block
    transition color .2s ease, opacity .2s ease, transform .2s ease
    &:last-of-type
      article
        border none
        &:after
          background none
          border none
          box-shadow none
          padding-bottom 20px
    &:hover h2,
    &:focus-visible h2
      color $body-link-hover-color
      transform translateX(4px)
      &:after
        transform scaleX(1)
        transform-origin left center
    &:focus-visible
      outline 2px solid rgba($body-link-hover-color, .45)
      outline-offset 6px
  .post-meta
    color lighten($body-color, 38%)
    color lighten($muted-color, 10%)
    display inline-block
    font-size .82rem
    line-height 1.6
    margin 0
  article.item, article.full
    p, li, blockquote
      font-family: '喜鹊聚珍体', $cu-font-family;
    strong
      font-family: '喜鹊聚珍体', $cu-font-family !important;
  article
    h1, h2, h3, h4, h5, h6, h7
      font-family: '喜鹊招牌体', $cu-font-family;
      font-weight: normal;
  article blockquote
    font-family: '喜鹊聚珍体', $cu-font-family;
  article.item
    background rgba(255, 255, 255, .94)
    border-radius 18px
    box-shadow 0 12px 34px rgba(0, 0, 0, .08)
    box-sizing border-box
    color $body-color
    padding 24px
    transition box-shadow .2s ease, transform .2s ease
    &:hover
      box-shadow 0 16px 42px rgba(0, 0, 0, .12)
      transform translateY(-2px)
    h2
      break-word normal
      color $body-color
      display inline-block
      margin-bottom 16px
      position relative
      transition color .2s ease, transform .2s ease
      word-wrap break-word
      &:after
        background currentColor
        bottom -.08em
        content ''
        height 2px
        left 0
        opacity .4
        position absolute
        transform scaleX(0)
        transform-origin right center
        transition transform .2s ease
        width 100%
    h2
      font-size 2.3em
      letter-spacing -1px
      line-height 1.2em
      text-indent -2px
    p.post-excerpt
      color lighten($body-color, 16%)
      font-size 1rem
      line-height 1.85
      margin 16px 0 0 0
    &:after
      display none
      content ''
  article.item + article.item
    margin-top 28px
  a.article + a.article
    article.item
      margin-top 28px
  div.pagination
    margin-top 20px
    > *
      margin 0 5px
    a
      color lighten($body-link-hover-color, 45%)
      display inline-block
      transition color .2s ease, opacity .2s ease, transform .2s ease
    a:hover,
    a:focus-visible
      color $body-link-hover-color
      transform translateY(-1px)
    a:focus-visible
      outline 2px solid rgba($body-link-hover-color, .45)
      outline-offset 4px
  .article-toc
    box-sizing border-box
    max-width 100%
    float right
    border-radius 15px
    border 1px solid $border-color
    padding 2rem
    margin-left 20px
    display none
    ol
      list-style none
      list-style-position inside
      padding 0
      padding-left 15px
  footer
    &:before
      clear both
    border-radius 15px
    margin-top 20px
    text-align center
    position relative
    padding 4rem 0
    border 1px solid $border-color
    font-size 1em
    line-height 2.1em
    color $muted-color
    background $surface-color
    a
      background linear-gradient(rgba($body-link-hover-color, .12), rgba($body-link-hover-color, .12)) 0 100% / 100% 0 no-repeat
      color lighten($body-color, 20%)
      font-weight 700
      transition background-size .2s ease, color .2s ease
      &:hover,
      &:focus-visible
        background-size 100% 42%
        color $body-link-hover-color
      &:focus-visible
        outline 2px solid rgba($body-link-hover-color, .45)
        outline-offset 3px
    .copyright
      color darken($muted-color, 10%)
      font-weight 500
    .intro
      font-size 0.7em
      font-family: '喜鹊聚珍体', $cu-font-family;

@media (min-width 720px)
  body
    main
      flex 2
      padding 40px
      article.item
        padding 40px
      article.item + article.item
        margin-top 34px
      a.article + a.article
        article.item
          margin-top 34px
      .article-toc
        display block
