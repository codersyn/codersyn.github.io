main
  background $background-color
  flex 2
  hypens auto
  overflow-x hidden
  padding 20px
  text-align left
  word-break normal
  word-wrap break-word
  a.article
    color $body-color
    &:last-of-type
      article
        border none
        &:after
          background none
          border none
          box-shadow none
          padding-bottom 20px
    &:hover h2
      transition color .3s ease
      color $body-link-hover-color
  .post-meta
    color lighten($body-color, 38%)
    color lighten($muted-color, 10%)
    display inline-block
    font-size .82rem
    line-height 1.6
    margin 0
  article.item, article.full
    p, li, blockquote
      font-family: '喜鹊聚珍体', $cu-font-family;
    strong
      font-family: '喜鹊聚珍体', $cu-font-family !important;
  article
    h1, h2, h3, h4, h5, h6, h7
      font-family: '喜鹊招牌体', $cu-font-family;
      font-weight: normal;
  article blockquote
    font-family: '喜鹊聚珍体', $cu-font-family;
  article.item
    background rgba(255, 255, 255, .94)
    border-radius 18px
    box-shadow 0 12px 34px rgba(0, 0, 0, .08)
    box-sizing border-box
    color $body-color
    padding 24px
    transition box-shadow .3s ease, transform .3s ease
    &:hover
      box-shadow 0 16px 42px rgba(0, 0, 0, .12)
      transform translateY(-2px)
    h2
      break-word normal
      color $body-color
      margin-bottom 16px
      word-wrap break-word
    h2
      font-size 2.3em
      letter-spacing -1px
      line-height 1.2em
      text-indent -2px
    p.post-excerpt
      color lighten($body-color, 16%)
      font-size 1rem
      line-height 1.85
      margin 16px 0 0 0
    &:after
      display none
      content ''
  article.item + article.item
    margin-top 28px
  a.article + a.article
    article.item
      margin-top 28px
  div.pagination
    margin-top 20px
    > *
      margin 0 5px
    a
      color lighten($body-link-hover-color, 45%)
    a:hover
      transition color .3s ease
      color $body-link-hover-color
  .article-toc
    box-sizing border-box
    max-width 100%
    display none
    background rgba(255, 255, 255, .72)
    border 1px solid rgba(0, 0, 0, .06)
    border-radius 16px
    box-shadow 0 10px 28px rgba(0, 0, 0, .05)
    color lighten($body-color, 18%)
    font-size .88rem
    line-height 1.65
    margin 18px 0 28px
    padding 1rem 1.15rem
    strong
      color $body-color
      display block
      font-family: '喜鹊招牌体', $cu-font-family;
      font-size 1rem
      font-weight normal
      margin-bottom .55rem
    ol
      list-style none
      margin 0
      padding 0
      ol
        border-left 1px solid rgba(0, 0, 0, .06)
        margin .22rem 0 .28rem .35rem
        padding-left .75rem
    li
      margin .18rem 0
    a
      border-radius 8px
      color lighten($body-color, 12%)
      display block
      padding .08rem .25rem
      transition background .2s ease, color .2s ease
      &:hover
        background rgba(0, 0, 0, .035)
        color $body-link-hover-color
  footer
    &:before
      clear both
    border-radius 15px
    margin-top 20px
    text-align center
    position relative
    padding 4rem 0
    border 1px solid $border-color
    font-size 1em
    line-height 2.1em
    color $muted-color
    background $surface-color
    a
      color lighten($body-color, 20%)
      font-weight 700
    .copyright
      color darken($muted-color, 10%)
      font-weight 500
    .intro
      font-size 0.7em
      font-family: '喜鹊聚珍体', $cu-font-family;

@media (min-width 720px)
  body
    main
      flex 2
      padding 40px
      article.item
        padding 40px
      article.item + article.item
        margin-top 34px
      a.article + a.article
        article.item
          margin-top 34px
      .article-toc
        display block

@media (min-width 1100px)
  body
    main
      article.full
        align-items start
        display grid
        gap 0 32px
        grid-template-columns minmax(0, 1fr) 240px
        > *
          grid-column 1
        .article-toc
          align-self start
          grid-column 2
          grid-row 1 / span 999
          margin 0
          max-height calc(100vh - 48px)
          overflow auto
          position sticky
          top 24px
