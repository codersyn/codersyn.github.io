@keyframes slide
  0%
    transform translate3d(0, 0, 0)
  100%
    transform translate3d(-240px, -240px, 0)

header
  flex 1
  overflow hidden
  position relative
  text-align center
  a, h1, p, nav
    position relative
    z-index 2
  img.logo
    width 72px
    height 72px
    border-radius 50%
  a
    color $header-line-color
  h1
    font-family $heading-font-family
    font-weight: normal;
    font-size 2.6em
    margin-top 20px
    line-height 1.12em
    letter-spacing 0
    text-shadow 0 1px 6px hsla(0, 0, 0, .5)
    a
      color $title-color
  p
    color $description-color
    font-family $tagline-font-family
    letter-spacing 0
    margin 0 auto
    max-width 22em
    line-height 1.45em
    text-shadow 0 1px 3px hsla(0, 0, 0, .35)
    font-size 1.25em
  nav
    ul
      list-style none
      margin 0
      padding 0
      li
        font-family $nav-font-family
        color $header-line-color
        display inline-block
        padding 12px 0 12px 12px
        font-size 1.3em
        &:after
          content '.'
          padding-left 12px
        &:last-child
          &:after
            content ''
        a
          color $header-li-color
        a:hover
          color $title-color
          text-decoration underline
          transition color .3s ease
    .xnews-icon
      margin-top 10px
      font-family xnews-icon
      font-size 1.5em
      a
        margin 4px
        color $header-icon-color
        &:hover
          color $title-color
          transition color .3s ease
  .space
    animation slide 8s linear infinite
    background-image url('../images/stars.svg')
    background-position center center
    background-size 240px
    height 400%
    left 0
    position absolute
    top 0
    width 400%
    z-index 1

@media (min-width 720px)
  body
    header
      flex 1
      overflow hidden
      text-align right
      padding 40px
      h1
        font-size 3.5em
        line-height 1.05em
        letter-spacing -.5px
      p
        margin 0 0 0 auto
        max-width 18em
        line-height 1.4em
        font-size 1.55em
    nav
      ul
        padding-top 24px
        li
          display block
          line-height 1.6em
          padding 0
          &:after
            content ''
            padding 0
